@page "/admin/diagnoses"
@attribute [Authorize(Roles = ApplicationRoles.Administrator)]
@using HospitalInformationSystem.Contracts.Diagnoses
@implements IDisposable
@inject DiagnosesApiClient Api

<PageTitle>Диагнозы · Учебная HIS</PageTitle>
<div class="eyebrow"><span class="eyebrow-line"></span> СПРАВОЧНИКИ УЧРЕЖДЕНИЯ</div>
<div class="page-heading">
  <div><h1>Справочник диагнозов</h1>
    <p>Коды и наименования для электронных медицинских карт.</p></div>
  <button class="btn btn-primary" disabled="@IsMutating" @onclick="BeginCreate">
    <Icon Name="plus"/>
    Добавить диагноз</button>
</div>

<section class="surface diagnosis-import" aria-labelledby="import-title" aria-busy="@_importing">
  <div class="registry-heading">
    <div><h2 id="import-title">Импорт из CSV</h2>
      <p>Добавьте диагнозы или обновите названия по их кодам.</p></div>
    <span class="section-index">01 / ИМПОРТ</span></div>
  <div class="import-content">
    <p id="csv-help">Файл UTF-8 до 1 МиБ, не более 10 000 записей. Заголовок <code>Code,Name</code>, разделитель —
      запятая.
      Код — 6 символов, название — от 3 до 24. Значения с запятой заключайте в двойные кавычки.</p>
    <p>Коды и названия внутри файла должны быть уникальны. Название, занятое другим кодом в справочнике, вызовет
      конфликт.
      При ошибке весь импорт отменяется.</p>
    <div class="import-controls">
      <div><label for="diagnosis-csv">CSV-файл</label>
        <InputFile id="diagnosis-csv" class="form-control" accept=".csv,text/csv" OnChange="SelectFile"
                   disabled="@IsMutating" aria-describedby="csv-help"/>
      </div>
      <button class="btn btn-primary" disabled="@(_file is null || IsMutating || _loading)"
              @onclick="ImportAsync">@(_importing ? "Импортируем…" : "Импортировать")</button>
      <a href="examples/diagnoses.csv" download="diagnoses.csv">Скачать пример</a>
    </div>
    <ErrorAlert Message="@_importError"/>
    @if (_result is not null)
    {
      <div class="import-result" role="status">Импорт завершён. Добавлено: @_result.Created ·
        Обновлено: @_result.Updated · Без изменений: @_result.Unchanged</div>
    }
  </div>
</section>

@if (_formOpen)
{
  <section class="surface" aria-label="@(_editingId is null ? "Новый диагноз" : "Редактирование диагноза")">
    <div class="registry-heading">
      <div>
        <h2>@(_editingId is null ? "Новый диагноз" : "Редактирование диагноза")</h2>
        <p>Код — ровно 6 символов, название — от 3 до 24 символов. Код и название должны быть уникальны.</p>
      </div>
      <span class="section-index">@(_editingId is null ? "НОВЫЙ" : "ПРАВКА")</span>
    </div>
    <EditForm Model="_form" OnValidSubmit="SaveAsync">
      <DataAnnotationsValidator/>
      <fieldset disabled="@IsMutating">
        <div class="form-grid">
          <div>
            <label for="diagnosis-code">Код</label>
            <InputText id="diagnosis-code" class="form-control" @bind-Value="_form.Code" maxlength="6"
                       placeholder="Например, A00.00"/>
            <ValidationMessage For="() => _form.Code"/>
          </div>
          <div>
            <label for="diagnosis-name">Наименование</label>
            <InputText id="diagnosis-name" class="form-control" @bind-Value="_form.Name" maxlength="24"
                       placeholder="Например, Холера"/>
            <ValidationMessage For="() => _form.Name"/>
          </div>
        </div>
        <ErrorAlert Message="@_formError"/>
        <div class="form-actions">
          <button type="button" class="btn btn-light" disabled="@IsMutating" @onclick="CancelForm">Отмена</button>
          <button type="submit" class="btn btn-primary">
            <Icon Name="check"/> @(_saving ? "Сохранение…" : "Сохранить")
          </button>
        </div>
      </fieldset>
    </EditForm>
  </section>
}

@if (_pendingDelete is not null)
{
  <div class="confirm-panel" role="alertdialog" aria-labelledby="diagnosis-delete-title">
    <div>
      <strong id="diagnosis-delete-title">Удалить диагноз из справочника?</strong>
      <p><code>@_pendingDelete.Code</code> @_pendingDelete.Name — записи в уже созданных медкартах сохранятся.</p>
    </div>
    <ErrorAlert Message="@_deleteError"/>
    <div class="button-row">
      <button class="btn btn-danger" disabled="@IsMutating" @onclick="DeleteAsync">
        @(_deleting ? "Удаление…" : "Удалить")
      </button>
      <button class="btn btn-light" disabled="@IsMutating" @onclick="CancelDelete">Отмена</button>
    </div>
  </div>
}

<ErrorAlert Message="@_listError"/>
<section class="surface" aria-label="Список диагнозов">
  <div class="registry-heading">
    <div><h2>Диагнозы учреждения</h2>
      <p>Справочник обновляется после успешного импорта.</p></div>
    <span class="section-index">02 / РЕЕСТР</span></div>
  <div class="table-toolbar">
    <div class="search-field">
      <Icon Name="search"/>
      <input type="search" aria-label="Поиск диагноза" placeholder="Код или название диагноза" @bind="_search"
             @bind:event="oninput"/></div>
    <button class="btn btn-outline-primary" disabled="@(_loading || _importing)" @onclick="LoadAsync">Обновить список
    </button>
  </div>
  @if (_loading)
  {
    <div class="empty-state" role="status">Загрузка диагнозов…</div>
  }
  else if (_diagnoses is null)
  {
    <div class="empty-state">Не удалось загрузить справочник. Повторите загрузку списка.</div>
  }
  else
  {
    <div class="table-responsive">
      <table class="table mr-table">
        <thead>
        <tr>
          <th scope="col">Код</th>
          <th scope="col">Наименование</th>
          <th scope="col" class="actions-cell">Действия</th>
        </tr>
        </thead>
        <tbody>@foreach (var diagnosis in VisibleDiagnoses)
        {
          <tr @key="diagnosis.Id">
            <td data-label="Код"><code>@diagnosis.Code</code></td>
            <td data-label="Наименование">@diagnosis.Name</td>
            <td class="actions-cell">
              <button class="icon-button" title="Редактировать диагноз" disabled="@IsMutating"
                      aria-label="Редактировать: @diagnosis.Code @diagnosis.Name" @onclick="() => BeginEdit(diagnosis)">
                <Icon Name="edit"/>
              </button>
              <button class="icon-button danger" title="Удалить диагноз" disabled="@IsMutating"
                      aria-label="Удалить: @diagnosis.Code @diagnosis.Name" @onclick="() => AskDelete(diagnosis)">
                <Icon Name="delete"/>
              </button>
            </td>
          </tr>
        }
        </tbody>
      </table>
    </div>
    @if (!VisibleDiagnoses.Any())
    {
      <div
        class="empty-state">@(_diagnoses.Count == 0 ? "В справочнике пока нет диагнозов. Загрузите CSV-файл выше." : "По вашему запросу ничего не найдено.")</div>
    }

    <div class="table-footer"><span>Показано @VisibleDiagnoses.Count() из @_diagnoses.Count диагнозов</span></div>
  }
</section>

@code {
  private IReadOnlyList<DiagnosisDefinitionDto>? _diagnoses;
  private IBrowserFile? _file;
  private DiagnosisImportResultDto? _result;
  private string? _importError;
  private string? _listError;
  private string _search = "";
  private bool _loading = true;
  private bool _importing;

  private DiagnosisForm _form = new();
  private Guid? _editingId;
  private bool _formOpen;
  private bool _saving;
  private string? _formError;
  private DiagnosisDefinitionDto? _pendingDelete;
  private bool _deleting;
  private string? _deleteError;
  private CancellationTokenSource? _cts;
  private int _loadVersion;
  private bool _disposed;
  private bool IsMutating => _saving || _deleting || _importing;

  private IEnumerable<DiagnosisDefinitionDto> VisibleDiagnoses => (_diagnoses ?? [])
    .Where(x => $"{x.Code} {x.Name}".Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));

  protected override Task OnInitializedAsync()
  {
    _cts = new CancellationTokenSource();
    return LoadAsync();
  }

  private void BeginCreate()
  {
    if (IsMutating || _disposed)
    {
      return;
    }

    _editingId = null;
    _form = new DiagnosisForm();
    _formError = null;
    _formOpen = true;
  }

  private void BeginEdit(DiagnosisDefinitionDto diagnosis)
  {
    if (IsMutating || _disposed)
    {
      return;
    }

    _editingId = diagnosis.Id;
    _form = new DiagnosisForm { Code = diagnosis.Code, Name = diagnosis.Name };
    _formError = null;
    _formOpen = true;
  }

  private void CancelForm()
  {
    _formOpen = false;
    _formError = null;
  }

  private void AskDelete(DiagnosisDefinitionDto diagnosis)
  {
    if (IsMutating || _disposed)
    {
      return;
    }

    _pendingDelete = diagnosis;
    _deleteError = null;
  }

  private void CancelDelete()
  {
    _pendingDelete = null;
    _deleteError = null;
  }

  private async Task SaveAsync()
  {
    if (IsMutating || _cts is null || _disposed)
    {
      return;
    }

    var token = _cts.Token;
    _saving = true;
    _formError = null;
    try
    {
      var request = new SaveDiagnosisRequest(_form.Code.Trim(), _form.Name.Trim());
      DiagnosisDefinitionDto saved;
      if (_editingId is { } id)
      {
        saved = await Api.UpdateAsync(id, request, token);
      }
      else
      {
        saved = await Api.CreateAsync(request, token);
      }

      if (!IsCurrent(token))
      {
        return;
      }

      _diagnoses = (_diagnoses ?? []).Where(diagnosis => diagnosis.Id != saved.Id).Append(saved).ToArray();
      _formOpen = false;
      await LoadAsync();
    }
    catch (OperationCanceledException) when (token.IsCancellationRequested)
    {
    }
    catch (ApiException e)
    {
      _formError = e.Message;
    }
    catch (HttpRequestException)
    {
      _formError = "Не удалось связаться с сервером. Введённые данные сохранены в форме.";
    }
    catch (TaskCanceledException)
    {
      _formError = "Сервер не ответил вовремя. Обновите список, чтобы проверить результат.";
    }
    finally
    {
      _saving = false;
    }
  }

  private async Task DeleteAsync()
  {
    if (_pendingDelete is null || IsMutating || _cts is null || _disposed)
    {
      return;
    }

    var token = _cts.Token;
    _deleting = true;
    _deleteError = null;
    try
    {
      var deletedId = _pendingDelete.Id;
      await Api.DeleteAsync(deletedId, token);
      if (!IsCurrent(token))
      {
        return;
      }

      _diagnoses = _diagnoses?.Where(diagnosis => diagnosis.Id != deletedId).ToArray();
      _pendingDelete = null;
      await LoadAsync();
    }
    catch (OperationCanceledException) when (token.IsCancellationRequested)
    {
    }
    catch (ApiException e)
    {
      _deleteError = e.Message;
    }
    catch (HttpRequestException)
    {
      _deleteError = "Не удалось связаться с сервером.";
    }
    catch (TaskCanceledException)
    {
      _deleteError = "Сервер не ответил вовремя. Обновите список, чтобы проверить результат.";
    }
    finally
    {
      _deleting = false;
    }
  }

  private void SelectFile(InputFileChangeEventArgs args)
  {
    _file = null;
    _result = null;
    _importError = null;
    if (args.File.Size == 0)
    {
      _importError = "Выбранный файл пуст.";
    }
    else if (args.File.Size > DiagnosisImportLimits.MaxFileBytes)
    {
      _importError = "Размер файла не должен превышать 1 МиБ.";
    }
    else
    {
      _file = args.File;
    }
  }

  private async Task ImportAsync()
  {
    if (_file is null || IsMutating || _loading || _cts is null || _disposed)
    {
      return;
    }

    var token = _cts.Token;
    _importing = true;
    _importError = null;
    _result = null;
    try
    {
      await using var stream = _file.OpenReadStream(DiagnosisImportLimits.MaxFileBytes, token);
      _result = await Api.ImportAsync(stream, _file.Name, token);
      await LoadAsync();
    }
    catch (OperationCanceledException) when (token.IsCancellationRequested)
    {
    }
    catch (ApiException e)
    {
      _importError = e.Message;
    }
    catch (HttpRequestException)
    {
      _importError = "Соединение с сервером прервано. Обновите список, чтобы проверить результат импорта.";
    }
    catch (TaskCanceledException)
    {
      _importError = "Сервер не ответил вовремя. Обновите список, чтобы проверить результат импорта.";
    }
    catch (IOException)
    {
      _importError = "Не удалось прочитать файл. Выберите его повторно.";
    }
    finally
    {
      _importing = false;
    }
  }

  private async Task LoadAsync()
  {
    if (_cts is null)
    {
      return;
    }

    var token = _cts.Token;
    var version = ++_loadVersion;
    _loading = true;
    _listError = null;
    try
    {
      var diagnoses = await Api.ListAsync(token);
      if (!IsCurrent(token) || version != _loadVersion)
      {
        return;
      }

      _diagnoses = diagnoses;
    }
    catch (OperationCanceledException) when (token.IsCancellationRequested)
    {
    }
    catch (ApiException e)
    {
      if (IsCurrent(token) && version == _loadVersion)
      {
        _listError = e.Message;
      }
    }
    catch (HttpRequestException)
    {
      if (IsCurrent(token) && version == _loadVersion)
      {
        _listError = "Не удалось обновить список: сервер недоступен.";
      }
    }
    catch (TaskCanceledException)
    {
      if (IsCurrent(token) && version == _loadVersion)
      {
        _listError = "Не удалось обновить список: сервер не ответил вовремя.";
      }
    }
    finally
    {
      if (IsCurrent(token) && version == _loadVersion)
      {
        _loading = false;
      }
    }
  }

  private bool IsCurrent(CancellationToken token) => !_disposed && !token.IsCancellationRequested;

  public void Dispose()
  {
    _disposed = true;
    _cts?.Cancel();
    _cts?.Dispose();
  }

  private sealed class DiagnosisForm
  {
    [Required(ErrorMessage = "Укажите код диагноза.")]
    [StringLength(6, MinimumLength = 6, ErrorMessage = "Код диагноза: ровно 6 символов.")]
    public string Code { get; set; } = "";

    [Required(ErrorMessage = "Укажите название диагноза.")]
    [StringLength(24, MinimumLength = 3, ErrorMessage = "Название: от 3 до 24 символов.")]
    public string Name { get; set; } = "";
  }

}

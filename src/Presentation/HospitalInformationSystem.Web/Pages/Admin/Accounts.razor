@page "/admin/accounts"
@using HospitalInformationSystem.Contracts.Lab2
@using HospitalInformationSystem.Web.Components.Accounts
@attribute [Authorize(Roles = ApplicationRoles.Administrator)]
@implements IDisposable
@inject HospitalInformationSystem.Web.Gateways.IAccountManagementGateway Gateway

<PageTitle>Учётные записи · Учебная HIS</PageTitle>
<div class="eyebrow"><span class="eyebrow-line"></span> ДОСТУП К СИСТЕМЕ</div>
<div class="page-heading">
  <div><h1>Учётные записи</h1>
    <p>Доступ сотрудников к системе и связь с медработниками.</p></div>
  <a class="btn btn-primary" href="/admin/medical-workers">
    <Icon Name="plus"/>
    Создать учётную запись</a>
</div>
<p class="field-hint">Учётная запись создаётся из карточки сотрудника: откройте медработника и добавьте ему доступ.
  Самостоятельный аккаунт без сотрудника создать нельзя.</p>

<ErrorAlert Message="@_listError"/>

<section class="surface" aria-label="Учётные записи">
  <div class="registry-heading">
    <div><h2>Пользователи системы</h2>
      <p>Список учётных записей и их состояние.</p></div>
    <button class="btn btn-outline-primary" disabled="@_loading" @onclick="LoadAsync">Обновить</button>
  </div>
  <div class="table-toolbar">
    <div class="search-field">
      <Icon Name="search"/>
      <input type="search" aria-label="Поиск по логину или сотруднику" placeholder="Логин или сотрудник"
             @bind="_search" @bind:event="oninput"/></div>
    <label class="checkbox-label" for="activity-filter">Активность:
      <select id="activity-filter" class="form-control activity-filter" @bind="_activityFilter">
        <option value="@ActivityFilter.All">Все</option>
        <option value="@ActivityFilter.Active">Только активные</option>
        <option value="@ActivityFilter.Inactive">Только неактивные</option>
      </select>
    </label>
  </div>
  <p class="field-hint toolbar-note">Поиск и фильтр применяются к уже загруженному списку.</p>
  @if (_loading)
  {
    <div class="empty-state" role="status">Загрузка учётных записей…</div>
  }
  else if (_accounts is null)
  {
    <div class="empty-state"><h2>Не удалось загрузить список</h2>
      <p>Проверьте подключение к серверу и повторите попытку.</p>
      <button class="btn btn-outline-primary" @onclick="LoadAsync">Повторить</button>
    </div>
  }
  else
  {
    <div class="table-responsive">
      <table class="table mr-table">
        <thead>
        <tr>
          <th scope="col">Логин</th>
          <th scope="col">Сотрудник</th>
          <th scope="col">Роль</th>
          <th scope="col">Создана</th>
          <th scope="col">Статус</th>
          <th scope="col" class="actions-cell">Действия</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var account in VisibleAccounts)
        {
          <tr @key="account.Id" class="@(account.Id == _selectedId ? "selected-row" : "")">
            <td data-label="Логин">@account.UserName</td>
            <td data-label="Сотрудник">@(account.MedicalWorkerName ?? "—")</td>
            <td data-label="Роль">
              @if (IsAdministrator(account))
              {
                <span class="status status-admin"><span class="status-dot"></span>Администратор</span>
              }
              else
              {
                @MedicalRoleLabels.Describe(account.MedicalWorkerRole)
              }
            </td>
            <td data-label="Создана">@account.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
            <td data-label="Статус">
              <span class="status @(account.IsActive ? "status-active" : "status-deleted")">
                <span class="status-dot"></span>@(account.IsActive ? "Активна" : "Деактивирована")
              </span>
              @if (account.IsLockedOut)
              {
                <span class="status status-warning"><span class="status-dot"></span>Временно заблокирована</span>
              }
            </td>
            <td class="actions-cell">
              @if (IsAdministrator(account))
              {
                <span class="field-hint">Единственный администратор</span>
              }
              else
              {
                <button class="row-edit" @onclick="() => Select(account.Id)">
                  @(account.Id == _selectedId ? "Скрыть" : "Управление")
                  <Icon Name="forward"/>
                </button>
              }
            </td>
          </tr>
        }
        </tbody>
      </table>
    </div>
    @if (!VisibleAccounts.Any())
    {
      <div class="empty-state">
        @(_accounts.Count == 0 ? "Учётные записи ещё не созданы." : "По условиям поиска ничего не найдено.")
      </div>
    }
    <div class="table-footer"><span>Показано @VisibleAccounts.Count() из @_accounts.Count записей</span></div>
  }
</section>

@if (SelectedAccount is { } selected && !IsAdministrator(selected))
{
  <section class="surface account-panel" aria-label="Управление учётной записью">
    <div class="registry-heading">
      <div><h2>@selected.UserName</h2>
        <p>@(selected.MedicalWorkerName ?? "Сотрудник не указан") · @MedicalRoleLabels.Describe(selected.MedicalWorkerRole)</p></div>
      <button class="btn btn-light" @onclick="() => _selectedId = null">Закрыть</button>
    </div>
    <AccountOperations Account="selected" WorkerDeleted="@(selected.MedicalWorkerName is null)" OnChanged="OnAccountChanged"/>
  </section>
}

@code {
  private IReadOnlyList<Lab2AccountDto>? _accounts;
  private readonly CancellationTokenSource _cancellation = new();
  private bool _loading = true;
  private int _loadVersion;
  private string? _listError;
  private string _search = "";
  private ActivityFilter _activityFilter = ActivityFilter.All;
  private Guid? _selectedId;

  private enum ActivityFilter
  {
    All,
    Active,
    Inactive
  }

  private Lab2AccountDto? SelectedAccount => _accounts?.FirstOrDefault(account => account.Id == _selectedId);

  private IEnumerable<Lab2AccountDto> VisibleAccounts => (_accounts ?? [])
    .Where(account => MatchesActivity(account) && MatchesSearch(account));

  private bool MatchesActivity(Lab2AccountDto account) => _activityFilter switch
  {
    ActivityFilter.Active => account.IsActive,
    ActivityFilter.Inactive => !account.IsActive,
    _ => true
  };

  private bool MatchesSearch(Lab2AccountDto account)
  {
    var term = _search.Trim();
    if (term.Length == 0)
    {
      return true;
    }

    return $"{account.UserName} {account.MedicalWorkerName}".Contains(term, StringComparison.OrdinalIgnoreCase);
  }

  private static bool IsAdministrator(Lab2AccountDto account) => account.AccountRole == ApplicationRoles.Administrator;

  protected override Task OnInitializedAsync() => LoadAsync();

  private async Task LoadAsync()
  {
    var version = ++_loadVersion;
    _loading = true;
    _listError = null;
    try
    {
      var accounts = await Gateway.ListAsync(_cancellation.Token);
      if (_cancellation.IsCancellationRequested || version != _loadVersion)
      {
        return;
      }

      _accounts = accounts;
      if (_selectedId is { } id && accounts.All(account => account.Id != id))
      {
        _selectedId = null;
      }
    }
    catch (OperationCanceledException) when (_cancellation.IsCancellationRequested)
    {
    }
    catch (ApiException exception)
    {
      if (!_cancellation.IsCancellationRequested && version == _loadVersion)
      {
        _listError = exception.Message;
      }
    }
    catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
    {
      if (!_cancellation.IsCancellationRequested && version == _loadVersion)
      {
        _listError = "Не удалось загрузить учётные записи. Повторите попытку.";
      }
    }
    finally
    {
      if (version == _loadVersion)
      {
        _loading = false;
      }
    }
  }

  private void Select(Guid id) => _selectedId = _selectedId == id ? null : id;

  private void OnAccountChanged(Lab2AccountDto account)
  {
    _accounts = (_accounts ?? [])
      .Select(item => item.Id == account.Id ? account : item)
      .ToArray();
  }

  public void Dispose()
  {
    _cancellation.Cancel();
    _cancellation.Dispose();
  }
}

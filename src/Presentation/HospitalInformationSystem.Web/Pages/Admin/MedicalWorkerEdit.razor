@page "/admin/medical-workers/new"
@page "/admin/medical-workers/{Id:guid}"
@attribute [Authorize(Roles = ApplicationRoles.Administrator)]
@implements IDisposable
@inject MedicalWorkersApiClient Api
@inject NavigationManager Navigation

<PageTitle>@(Id is null ? "Новый медработник" : "Карточка медработника") · Учебная HIS</PageTitle>
<a class="back-link" href="/admin/medical-workers">
  <Icon Name="arrow"/>
  К списку медработников</a>
<div class="page-heading">
  <div><h1>@(Id is null ? "Новый медработник" : "Редактирование медработника")</h1>
    <p>Основные данные сотрудника лечебного учреждения</p></div>
</div>
<ErrorAlert Message="@_error"/>
@if (_loading)
{
  <div class="surface empty-state" role="status">Загрузка карточки…</div>
}
else if (_model is not null)
{
  <div class="profile-layout">
    <aside class="profile-panel" aria-label="Сведения о сотруднике">
      <span class="eyebrow">КАРТОЧКА СОТРУДНИКА</span>
      <div class="profile-avatar">
        <Icon Name="patients"/>
      </div>
      <h2>@(string.IsNullOrWhiteSpace(_model.LastName) ? "Новый сотрудник" : _model.LastName)<span>@_model.FirstName</span>
      </h2>
      <p
        class="profile-position">@(string.IsNullOrWhiteSpace(_model.Position) ? "Должность ещё не указана" : _model.Position)</p>
      <WorkerStatus IsDeleted="@(_worker?.IsDeleted ?? false)"/>
      <div class="profile-note">
        <Icon Name="record"/>
        <p>Актуальные сведения помогают поддерживать порядок в реестре учреждения.</p></div>
    </aside>
    <section class="surface edit-surface" aria-label="Редактирование данных">
      <EditForm Model="_model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator/>
        <fieldset disabled="@_busy">
          <div class="form-section">
            <div class="section-title"><span class="step-number">01</span>
              <div><h2>Основные сведения</h2>
                <p>Укажите имя и фамилию сотрудника.</p></div>
            </div>
            <div class="form-grid">
              <div><label for="lastName">Фамилия</label>
                <InputText id="lastName" class="form-control" @bind-Value="_model.LastName" maxlength="24"
                           placeholder="Например, Иванов" autocomplete="family-name"/>
                <ValidationMessage For="() => _model.LastName"/>
              </div>
              <div><label for="firstName">Имя</label>
                <InputText id="firstName" class="form-control" @bind-Value="_model.FirstName" maxlength="24"
                           placeholder="Например, Алексей" autocomplete="given-name"/>
                <ValidationMessage For="() => _model.FirstName"/>
              </div>
            </div>
          </div>
          <div class="form-section">
            <div class="section-title"><span class="step-number">02</span>
              <div><h2>Работа в учреждении</h2>
                <p>Выберите подсказку или введите свою должность.</p></div>
            </div>
            <div><label for="position">Должность</label>
              <InputText id="position" class="form-control" @bind-Value="_model.Position" list="positions"
                         maxlength="24" placeholder="Например, врач-терапевт"/>
              <ValidationMessage For="() => _model.Position"/>
              <datalist id="positions">
                <option>Врач-терапевт</option>
                <option>Врач-хирург</option>
                <option>Врач-анестезиолог</option>
                <option>Медицинская сестра</option>
              </datalist>
            </div>
            <p class="field-hint">Все поля обязательны. От 3 до 24 символов в каждом поле.</p>
          </div>
          <div class="form-actions">
            <a class="btn btn-light" href="/admin/medical-workers">Отмена</a>
            <button type="submit" class="btn btn-primary">
              <Icon Name="check"/> @(_busy ? "Сохранение…" : "Сохранить")</button>
          </div>
        </fieldset>
      </EditForm>
      @if (_worker is { IsDeleted: false })
      {
        <div class="delete-section">
          <div><strong>Сотрудник больше не работает?</strong>
            <p>Можно пометить его запись как удалённую.</p></div>
          <button type="button" class="btn btn-soft-danger" disabled="@_busy" @onclick="() => _confirmDelete = true">
            <Icon Name="delete"/>
            Пометить удалённым
          </button>
        </div>
      }
      @if (_confirmDelete)
      {
        <ConfirmDelete Worker="_worker" Busy="_busy" OnConfirm="DeleteAsync" OnCancel="() => _confirmDelete = false"/>
      }
    </section>
  </div>
}
else
{
  <button class="btn btn-outline-primary" @onclick="LoadAsync">Повторить загрузку</button>
}

@code {
  [Parameter] public Guid? Id { get; set; }
  private WorkerForm? _model;
  private MedicalWorkerDto? _worker;
  private string? _error;
  private bool _loading;
  private bool _busy;
  private bool _confirmDelete;
  private bool _disposed;
  private CancellationTokenSource? _routeCancellation;
  protected override Task OnParametersSetAsync() => LoadAsync();

  private async Task LoadAsync()
  {
    _routeCancellation?.Cancel();
    _routeCancellation?.Dispose();
    _routeCancellation = new CancellationTokenSource();
    var cancellationToken = _routeCancellation.Token;
    _loading = true;
    _busy = false;
    _error = null;
    _worker = null;
    _model = null;
    _confirmDelete = false;
    try
    {
      var worker = Id is { } id ? await Api.GetAsync(id, cancellationToken) : null;
      if (!IsCurrent(cancellationToken))
      {
        return;
      }

      _worker = worker;
      _model = new WorkerForm { FirstName = _worker?.FirstName ?? "", LastName = _worker?.LastName ?? "", Position = _worker?.Position ?? "" };
    }
    catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
    {
    }
    catch (ApiException e)
    {
      if (IsCurrent(cancellationToken))
      {
        _error = e.Message;
      }
    }
    catch (HttpRequestException)
    {
      if (IsCurrent(cancellationToken))
      {
        _error = "Не удалось связаться с сервером.";
      }
    }
    catch (TaskCanceledException)
    {
      if (IsCurrent(cancellationToken))
      {
        _error = "Сервер не ответил вовремя. Повторите попытку.";
      }
    }
    finally
    {
      if (IsCurrent(cancellationToken))
      {
        _loading = false;
      }
    }
  }

  private Task SaveAsync() => ExecuteAsync(async cancellationToken =>
  {
    if (_model is null)
    {
      return;
    }

    await Api.SaveAsync(Id, new SaveMedicalWorkerRequest(_model.FirstName, _model.LastName, _model.Position), cancellationToken);
  });

  private Task DeleteAsync() => ExecuteAsync(async cancellationToken =>
  {
    if (Id is { } id)
    {
      await Api.DeleteAsync(id, cancellationToken);
    }
  });

  private async Task ExecuteAsync(Func<CancellationToken, Task> action)
  {
    if (_busy || _routeCancellation is null || _disposed)
    {
      return;
    }

    var cancellationToken = _routeCancellation.Token;
    _busy = true;
    _error = null;
    try
    {
      await action(cancellationToken);
      if (IsCurrent(cancellationToken))
      {
        Navigation.NavigateTo("/admin/medical-workers");
      }
    }
    catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
    {
    }
    catch (ApiException e)
    {
      if (IsCurrent(cancellationToken))
      {
        _error = e.Message;
      }
    }
    catch (HttpRequestException)
    {
      if (IsCurrent(cancellationToken))
      {
        _error = "Не удалось связаться с сервером. Введённые данные сохранены в форме.";
      }
    }
    catch (TaskCanceledException)
    {
      if (IsCurrent(cancellationToken))
      {
        _error = "Сервер не ответил вовремя. Проверьте список перед повторным сохранением.";
      }
    }
    finally
    {
      if (IsCurrent(cancellationToken))
      {
        _busy = false;
      }
    }
  }

  private bool IsCurrent(CancellationToken cancellationToken) => !_disposed && !cancellationToken.IsCancellationRequested;

  public void Dispose()
  {
    _disposed = true;
    _routeCancellation?.Cancel();
    _routeCancellation?.Dispose();
  }

  private sealed class WorkerForm
  {
    [Required(ErrorMessage = "Укажите имя."), StringLength(24, MinimumLength = 3, ErrorMessage = "Имя: от 3 до 24 символов.")]
    public string FirstName { get; set; } = "";

    [Required(ErrorMessage = "Укажите фамилию."), StringLength(24, MinimumLength = 3, ErrorMessage = "Фамилия: от 3 до 24 символов.")]
    public string LastName { get; set; } = "";

    [Required(ErrorMessage = "Укажите должность."), StringLength(24, MinimumLength = 3, ErrorMessage = "Должность: от 3 до 24 символов.")]
    public string Position { get; set; } = "";
  }

}

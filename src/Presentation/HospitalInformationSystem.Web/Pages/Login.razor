@page "/login"
@layout LoginLayout
@implements IDisposable
@inject SessionApiClient Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>Вход · Учебная HIS</PageTitle>
<section class="surface login-card" aria-labelledby="login-title">
  <div class="registry-heading">
    <div><span class="eyebrow">УЧЕБНАЯ HIS</span><h1 id="login-title">Вход в систему</h1>
      <p>Используйте учётную запись, выданную администратором.</p></div>
  </div>
  <EditForm Model="_form" OnValidSubmit="LoginAsync">
    <DataAnnotationsValidator/>
    <fieldset disabled="@_busy">
      <div class="mr-field">
        <label for="user-name">Логин</label>
        <InputText id="user-name" class="form-control" @bind-Value="_form.UserName" autocomplete="username"
                   maxlength="64"/>
        <ValidationMessage For="() => _form.UserName"/>
      </div>
      <div class="mr-field">
        <label for="password">Пароль</label>
        <InputText id="password" type="password" class="form-control" @bind-Value="_form.Password"
                   autocomplete="current-password" maxlength="128"/>
        <ValidationMessage For="() => _form.Password"/>
      </div>
      <ErrorAlert Message="@_error"/>
      <button type="submit" class="btn btn-primary">@(_busy ? "Вход…" : "Войти")</button>
    </fieldset>
  </EditForm>
</section>

@code {
  [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
  private readonly LoginForm _form = new();
  private readonly CancellationTokenSource _cancellation = new();
  private bool _busy;
  private string? _error;

  private async Task LoginAsync()
  {
    if (_busy)
    {
      return;
    }

    _busy = true;
    _error = null;
    try
    {
      await Api.LoginAsync(new LoginRequest(_form.UserName.Trim(), _form.Password), _cancellation.Token);
      if (!_cancellation.IsCancellationRequested)
      {
        var isAdmin = Session.Current?.Role == ApplicationRoles.Administrator;
        var home = isAdmin ? "/admin/medical-workers" : "/medical/patients";
        var allowedPrefix = isAdmin ? "/admin/" : "/medical/";
        Navigation.NavigateTo(ReturnUrl is { } target && target.StartsWith(allowedPrefix, StringComparison.Ordinal)
            && !target.Contains('\\') ? target : home, replace: true);
      }
    }
    catch (OperationCanceledException) when (_cancellation.IsCancellationRequested)
    {
    }
    catch (ApiException exception)
    {
      _error = exception.StatusCode == System.Net.HttpStatusCode.Unauthorized
        ? "Неверный логин или пароль."
        : exception.Message;
    }
    catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
    {
      _error = "Сервер недоступен. Повторите попытку входа.";
    }
    finally
    {
      _form.Password = "";
      _busy = false;
    }
  }

  public void Dispose()
  {
    _form.Password = "";
    _cancellation.Cancel();
    _cancellation.Dispose();
  }

  private sealed class LoginForm
  {
    [Required(ErrorMessage = "Укажите логин.")]
    [StringLength(64, ErrorMessage = "Логин: не более 64 символов.")]
    public string UserName { get; set; } = "";

    [Required(ErrorMessage = "Укажите пароль.")]
    [StringLength(128, ErrorMessage = "Пароль: не более 128 символов.")]
    public string Password { get; set; } = "";
  }
}

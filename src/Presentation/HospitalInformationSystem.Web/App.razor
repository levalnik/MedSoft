<Router AppAssembly="typeof(App).Assembly">
  <Found Context="routeData">
    <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
      <Authorizing><div class="surface empty-state" role="status">Проверка сеанса…</div></Authorizing>
      <NotAuthorized Context="authentication">
        @if (authentication.User.Identity?.IsAuthenticated == true)
        {
          <div class="surface empty-state" role="alert">
            <h1>Недостаточно прав</h1>
            <p>Этот раздел недоступен для вашей роли.</p>
            <a class="btn btn-primary" href="/">На главную</a>
          </div>
        }
        else
        {
          <RedirectToLogin/>
        }
      </NotAuthorized>
    </AuthorizeRouteView>
    <FocusOnNavigate RouteData="routeData" Selector="h1" />
  </Found>
  <NotFound>
    <LayoutView Layout="typeof(MainLayout)">
      <h1>Страница не найдена</h1>
      <a href="/admin/medical-workers">Вернуться к медработникам</a>
    </LayoutView>
  </NotFound>
</Router>

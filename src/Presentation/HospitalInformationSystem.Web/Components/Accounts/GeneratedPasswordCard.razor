@using Microsoft.JSInterop
@inject IJSRuntime Js

@if (Password is { } password)
{
  <div class="surface password-card" role="status" aria-live="polite">
    <div>
      <strong>@Title</strong>
      <p>Пароль показывается один раз. Передайте его сотруднику и закройте блок — повторно он не отображается.</p>
    </div>
    <div class="password-row">
      <input class="form-control" readonly value="@password" aria-label="Сгенерированный пароль" onfocus="this.select()"/>
      <button type="button" class="btn btn-outline-primary" @onclick="() => CopyAsync(password)">
        @(_copied ? "Скопировано" : "Копировать")
      </button>
    </div>
    <button type="button" class="btn btn-light" @onclick="DismissAsync">Закрыть и скрыть пароль</button>
  </div>
}

@code {
  [Parameter] public string? Password { get; set; }
  [Parameter] public string Title { get; set; } = "Пароль создан";
  [Parameter] public EventCallback OnDismiss { get; set; }

  private bool _copied;

  private async Task CopyAsync(string password)
  {
    try
    {
      await Js.InvokeVoidAsync("navigator.clipboard.writeText", password);
      _copied = true;
    }
    catch (JSException)
    {
    }
    catch (InvalidOperationException)
    {
    }
  }

  private async Task DismissAsync()
  {
    _copied = false;
    if (OnDismiss.HasDelegate)
    {
      await OnDismiss.InvokeAsync();
    }
  }
}

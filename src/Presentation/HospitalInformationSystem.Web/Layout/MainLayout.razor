@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject SessionState Session
@inject HospitalInformationSystem.Web.Gateways.IAuthenticationGateway SessionsApi

<UiMockPanel/>
<div class="app-shell">
  <a class="skip-link" href="#main-content">Перейти к содержимому</a>
  <header class="app-header">
    <div class="header-inner">
      <a class="brand" href="/"><span class="brand-mark"><Icon Name="pulse"/></span><span>Учебная HIS<small>Госпитальная система</small></span></a>
      <div class="header-context"><span class="context-dot"></span>Рабочее пространство</div>
      <div class="mode-picker">
        @if (Session.Current is { } current)
        {
          <span class="mode-label">@current.UserName · @(IsMedical ? "Медработник" : "Администратор")</span>
          <button class="btn btn-light" disabled="@_loggingOut" @onclick="LogoutAsync">
            @(_loggingOut ? "Выход…" : "Выйти")
          </button>
        }
      </div>
    </div>
    <nav class="main-nav" aria-label="Основная навигация">
      @if (IsMedical)
      {
        <NavLink href="/medical/patients">
          <Icon Name="patients"/>
          Пациенты
        </NavLink>
      }
      else if (Session.Current?.Role == ApplicationRoles.Administrator)
      {
        <NavLink href="/admin/medical-workers">
          <Icon Name="workers"/>
          Медработники
        </NavLink>
        <NavLink href="/admin/diagnoses">
          <Icon Name="catalog"/>
          Диагнозы
        </NavLink>
        <NavLink href="/admin/accounts">
          <Icon Name="workers"/>
          Учётные записи
        </NavLink>
        <NavLink href="/admin/audit">
          <Icon Name="record"/>
          Аудит
        </NavLink>
      }
      <span class="nav-note">@(IsMedical ? "Работа с пациентами" : "Управление учреждением")</span>
    </nav>
  </header>
  <main id="main-content" tabindex="-1"><ErrorAlert Message="@_logoutError"/>@Body</main>
  <footer class="page-footer"><span>Учебная HIS <span class="footer-divider">/</span> Информация под рукой</span><span>Учебный проект · 2026</span>
  </footer>
</div>

@code {
  private bool IsMedical => Session.Current?.Role == ApplicationRoles.MedicalWorker;
  private bool _loggingOut;
  private string? _logoutError;
  protected override void OnInitialized()
  {
    Navigation.LocationChanged += OnLocationChanged;
    Session.Changed += OnSessionChanged;
  }
  private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => InvokeAsync(StateHasChanged);
  private void OnSessionChanged() => InvokeAsync(StateHasChanged);

  private async Task LogoutAsync()
  {
    if (_loggingOut)
    {
      return;
    }

    _loggingOut = true;
    _logoutError = null;
    try
    {
      var loginPath = Session.Current?.Role == ApplicationRoles.Administrator ? "/admin/login" : "/login";
      await SessionsApi.LogoutAsync(CancellationToken.None);
      Navigation.NavigateTo(loginPath, replace: true);
    }
    catch (Exception exception) when (exception is ApiException or HttpRequestException or TaskCanceledException)
    {
      _logoutError = "Не удалось завершить сеанс. Повторите выход.";
    }
    finally
    {
      _loggingOut = false;
    }
  }

  public void Dispose()
  {
    Navigation.LocationChanged -= OnLocationChanged;
    Session.Changed -= OnSessionChanged;
  }
}
